# JobClaw environment template.
# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env

# ---- LLM (required) ----
# Used for resume tailoring and questionnaire answer fallback.
# The name of this variable is itself configurable via `llm.api_key_env`
# in config/resume.yaml. Model and base URL are also set there.
OPENROUTER_API_KEY=

# ---- Storage ----
# SQLite database path. Default: data/jobclaw.db
JOBCLAW_DB_PATH=

# ---- Config overrides ----
# Defaults are config/candidate.yaml and config/preferences.yaml.
JOBCLAW_CANDIDATE_CONFIG=
JOBCLAW_PREFERENCES_CONFIG=

# ---- Discovery: JobSpy ----
# JobSpy MCP server endpoint. Default: http://127.0.0.1:8000/mcp
JOBCLAW_JOBSPY_URL=

# ---- Discovery: Greenhouse ----
# Comma or newline separated board tokens. Empty tokens are ignored.
#   JOBCLAW_GREENHOUSE_BOARDS=stripe,figma
JOBCLAW_GREENHOUSE_BOARDS=

# ---- Greenhouse form provider (optional) ----
# Setting a base URL enables the HTTP-backed Greenhouse form provider.
# Leave both blank to keep form fetching disabled.
JOBCLAW_GREENHOUSE_BASE_URL=
JOBCLAW_GREENHOUSE_API_KEY=

# ---- Test flags ----
# Opt in to tests that hit the live JobSpy MCP server. Skipped unless set to 1.
JOBCLAW_JOBSPY_LIVE_TEST=
